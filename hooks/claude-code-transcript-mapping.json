{
  "version": 1,
  "format": "claude-code-jsonl-v1",
  "message_text": [
    {
      "select": {
        "path": "$",
        "where": {
          "message.role": [
            "user",
            "assistant"
          ]
        }
      },
      "paths": [
        "message.content"
      ]
    },
    {
      "select": {
        "path": "message.content.*",
        "where": {
          "type": [
            "text"
          ]
        }
      },
      "paths": [
        "text"
      ]
    }
  ],
  "assistant_text": [
    {
      "select": {
        "path": "$",
        "where": {
          "message.role": [
            "assistant"
          ]
        }
      },
      "paths": [
        "message.content",
        "message.content.*.text"
      ]
    }
  ],
  "tool_calls": [
    {
      "select": {
        "path": "message.content.*",
        "where": {
          "type": [
            "tool_use"
          ]
        }
      },
      "id": "id",
      "file_paths": [
        "input.file_path",
        "input.path",
        "input.command",
        "input.cmd"
      ]
    }
  ],
  "tool_outputs": [
    {
      "select": {
        "path": "message.content.*",
        "where": {
          "type": [
            "tool_result"
          ]
        }
      },
      "id": "tool_use_id",
      "paths": [
        "$"
      ]
    },
    {
      "select": {
        "path": "$"
      },
      "id": "message.content.*.tool_use_id",
      "paths": [
        "toolUseResult"
      ],
      "file_paths": [
        "toolUseResult.file.filePath",
        "toolUseResult.file.path",
        "toolUseResult.file_path"
      ]
    }
  ],
  "images": [
    {
      "path": "message.content.*",
      "where": {
        "type": [
          "image"
        ]
      }
    },
    {
      "path": "message.content.*.content.*",
      "where": {
        "type": [
          "image"
        ]
      }
    }
  ],
  "drop": [
    {
      "path": "message.content",
      "contains": [
        "Base directory for this skill:",
        "<skill>",
        "<skills_instructions>"
      ]
    },
    {
      "path": "message.content.*.text",
      "contains": [
        "Base directory for this skill:",
        "<skill>",
        "<skills_instructions>"
      ]
    }
  ]
}
