{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "session-start",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--print-context",
              "--nudge",
              "Run /altitude:next-lesson to continue (or /altitude:begin if this is your first session).",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "pre-tool-use",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--gate",
              "plan",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "pre-tool-use",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--gate",
              "diff",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "stop",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--gate",
              "retro",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "session-end",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "altitude",
            "args": [
              "hook",
              "user-prompt-submit",
              "--agent",
              "claude-code",
              "--mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/field-mapping.json",
              "--transcript-mapping",
              "${CLAUDE_PLUGIN_ROOT}/hooks/claude-code-transcript-mapping.json"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
